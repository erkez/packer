{
  "name": "@ekz/packer",
  "version": "1.2.0",
  "description": "Opinionated Webpack and Vite configuration for React applications, with built-in ESLint and TypeScript support.",
  "keywords": [
    "react",
    "webpack",
    "vite",
    "bundler",
    "build-tool",
    "eslint",
    "typescript",
    "config"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "require": "./dist/vite.js",
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    },
    "./webpack": {
      "require": "./dist/webpack.js",
      "import": "./dist/webpack.js",
      "types": "./dist/webpack.d.ts"
    },
    "./recommended": "./config/eslint/recommended.js",
    "./typescript": "./config/eslint/typescript.js",
    "./tsconfig/*": "./tsconfig/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erkez/packer.git"
  },
  "homepage": "https://packer.ekz.io",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "config/**",
    "tsconfig/**",
    "LICENSE",
    "README.md",
    "yarn.lock"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "yarn build",
    "test": "yarn build && node --test 'test/**/*.test.js'",
    "lint": "npx eslint .",
    "lint:fix": "yarn lint --fix"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "dependencies": {
    "@ekz/eslint-config-packer": "workspace:^",
    "@ekz/packer-vite": "workspace:^",
    "@ekz/packer-webpack": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  }
}
