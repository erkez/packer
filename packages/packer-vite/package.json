{
  "name": "@ekz/packer-vite",
  "version": "1.2.0",
  "description": "Opinionated Vite configuration for React applications, with built-in TypeScript typechecking.",
  "keywords": [
    "react",
    "vite",
    "bundler",
    "build-tool",
    "typescript",
    "config"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tsconfig/*": "./tsconfig/*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erkez/packer.git",
    "directory": "packages/packer-vite"
  },
  "homepage": "https://packer.ekz.io",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "tsconfig/**",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "yarn build",
    "test": "yarn build && node --test 'test/**/*.test.js'",
    "lint": "npx eslint .",
    "lint:fix": "yarn lint --fix"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  }
}
